# fake = offline keyword baseline (default). anthropic = real model.
DELIVERYOPS_LLM=fake
ANTHROPIC_API_KEY=
DELIVERYOPS_MODEL=claude-sonnet-4-6

# Leave DATABASE_URL empty to run fully in memory (no Docker needed).
DATABASE_URL=
# lexical = offline BM25-ish (default); pgvector = vector search; hybrid = RRF fusion of both.
DELIVERYOPS_RETRIEVER=lexical
# All-or-nothing retrieval confidence cutoff; 0/empty = off (ADR 0010: calibrate per embedder).
DELIVERYOPS_RETRIEVAL_MIN_SCORE=

# --- Embeddings (ADR 0010) ---
# hash = offline default, no key needed. langchain = real provider via init_embeddings.
DELIVERYOPS_EMBEDDER=hash
DELIVERYOPS_EMBED_PROVIDER=openai
DELIVERYOPS_EMBED_MODEL=text-embedding-3-small
DELIVERYOPS_EVAL_REPORT=eval-report.json
DELIVERYOPS_API_URL=http://localhost:8000

# --- External intake (optional; unset = mock store / local repo) ---
# Jira Cloud REST intake. Set all three to go live; a subset is a loud startup error, never a
# silent fall back to the mock store. JIRA_PROJECT scopes listing and is required for creating.
JIRA_SITE=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT=

# GitHub read-only target for the code agent and the repo tools (owner/repo). No code path in
# this repo writes to GitHub: the agent proposes a diff, a human applies it (ADR 0006/0007).
DELIVERYOPS_GITHUB_REPO=
GITHUB_TOKEN=
DELIVERYOPS_GITHUB_REF=

# Checkpointer: postgres|memory. Default: postgres when DATABASE_URL is set, memory otherwise.
DELIVERYOPS_CHECKPOINTER=

# --- Model provider (LangChain init_chat_model; DELIVERYOPS_LLM=chat to activate) ---
DELIVERYOPS_PROVIDER=anthropic
# Any model the provider supports; cost is priced by llm/pricing.py (unknown = unpriced).
DELIVERYOPS_MODEL=claude-sonnet-4-6

# --- Guardrails ---
# Per-run LLM spend cap in USD; a run that crosses it fails closed. 0 disables.
DELIVERYOPS_MAX_RUN_COST_USD=1.00
